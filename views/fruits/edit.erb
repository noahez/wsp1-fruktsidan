<h2>Uppdatera frukt</h2>

<form action = "/fruits/<%= @fruit["id"] %>/update" method= "post" >
<lable>Nytt namn <input type= "text"  name ="ny_name" value = "<%= @fruit["name"]%>" > </lable>
<lable>Ny Beskrivning <input type= "text" name= "ny_desc" value = <%= @fruit["description"]%> > </lable>
<lable>Score <input type="number"  name="ny_score" value = <%= @fruit[""]%> >
<lable>kategori <select name="category_id">
	<% @categories.each do |category| %>
		<option value="<%= category['id'] %>"><%= category['name'] %></option>
<% end %>
</select>

<input type= "submit" value = "spara"  >

</form>
