<h2>Ny frukt</h2>
 <form action= "/fruits" method ="post">
    <label>Frukt <input type="text" name = "frukt_namn"></label>
    <label>Beskrivning <input type="text" name = "frukt_bes"></label>
    <label>score out of 10 <input type="number" name = "frukt_score"></label>
    <lable>kategori <select name="category_id">
	<% @categories.each do |category| %>
